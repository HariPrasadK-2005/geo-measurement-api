<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>Sample survey - Bengaluru</name>

    <Placemark>
      <name>Plot A</name>
      <description>Rectangular plot, roughly 1 km x 1.1 km</description>
      <ExtendedData>
        <Data name="owner"><value>Aereo Demo</value></Data>
        <Data name="survey_year"><value>2026</value></Data>
      </ExtendedData>
      <Polygon>
        <outerBoundaryIs>
          <LinearRing>
            <coordinates>
              77.590,12.970,0 77.600,12.970,0 77.600,12.980,0 77.590,12.980,0 77.590,12.970,0
            </coordinates>
          </LinearRing>
        </outerBoundaryIs>
      </Polygon>
    </Placemark>

    <Placemark>
      <name>Access road</name>
      <LineString>
        <coordinates>
          77.585,12.965,0 77.590,12.970,0 77.595,12.975,0 77.600,12.985,0
        </coordinates>
      </LineString>
    </Placemark>

    <Placemark>
      <name>Survey marker</name>
      <Point><coordinates>77.595,12.975,0</coordinates></Point>
    </Placemark>

    <Placemark>
      <name>Mixed (unsupported for measurement)</name>
      <MultiGeometry>
        <Point><coordinates>77.60,12.99,0</coordinates></Point>
        <Polygon>
          <outerBoundaryIs>
            <LinearRing>
              <coordinates>77.60,12.99,0 77.61,12.99,0 77.61,13.00,0 77.60,13.00,0 77.60,12.99,0</coordinates>
            </LinearRing>
          </outerBoundaryIs>
        </Polygon>
      </MultiGeometry>
    </Placemark>
  </Document>
</kml>
